POSTGRES_PASSWORD=changeme

# Cloudflare Access — fill in after creating the Access application
# for mikos-api.mmaly.cz. Leave empty + DEV_MODE=1 for local dev.
CF_ACCESS_TEAM_DOMAIN=mmaly.cloudflareaccess.com
CF_ACCESS_AUD=

# Comma-separated emails allowed to call the API (validated against
# the email claim on the CF Access JWT). Empty = allow any email
# that CF Access already let through.
MIKOS_ALLOWED_EMAILS=

# Origins allowed by CORS. mmaly.cz for the hub, localhost:5173 for vite dev.
CORS_ORIGINS=https://mmaly.cz,http://localhost:5173

# Set to 1 only for local dev — bypasses JWT validation and returns dev@local.
DEV_MODE=1

TZ=Europe/Prague
